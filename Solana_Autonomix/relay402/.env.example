# Copy to .env and edit. Every value below is optional; defaults target localnet.

# Shared
NETWORK=solana-localnet            # solana-localnet | solana-devnet
RPC_URL=http://127.0.0.1:8899

# Setup script (npm run setup)
ADMIN_KEYPAIR=~/.config/solana/id.json   # must be the program upgrade authority
# MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # devnet USDC; omit on localnet to create a test mint
FEE_BPS=100                        # 1% (max 1000)
MIN_PRICE=1000                     # 0.001 USDC
AGENT_PRICE=10000                  # 0.01 USDC
AGENT_PUBLIC_URL=http://127.0.0.1:4021

# Facilitator (npm run facilitator)
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=4020
# FACILITATOR_KEYPAIR=.keys/facilitator.json

# Agent server (npm run agent)
AGENT_HOST=127.0.0.1
AGENT_PORT=4021
FACILITATOR_URL=http://127.0.0.1:4020
MAX_TIMEOUT_SECONDS=120
TASK_TIMEOUT_MS=60000
FACILITATOR_TIMEOUT_MS=90000
# OPERATOR_KEYPAIR=.keys/operator.json
# AGENT_ID=0
# ANTHROPIC_API_KEY=                # set to call Claude; unset = deterministic stub
# AGENT_MODEL=claude-sonnet-5

# Client (npm run client:call / client:feedback / client:refund)
MAX_AMOUNT=50000                   # never pay more than this per request
# CLIENT_KEYPAIR=.keys/client.json
# AGENT_URL=http://127.0.0.1:4021/api/run
